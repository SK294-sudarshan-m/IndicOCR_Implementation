.venv/
models/
out/
build/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/

# input documents and generated results stay local; the folders themselves are tracked
input/*
output/*
!input/.gitkeep
!output/.gitkeep

# keep the two result folders tracked (contents ignored)
!output/ocr_output/
!output/judge_output/
output/ocr_output/*
output/judge_output/*
!output/ocr_output/.gitkeep
!output/judge_output/.gitkeep
